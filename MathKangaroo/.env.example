DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local development uses SQLite. Set DB_ENGINE=postgresql in production.
DB_ENGINE=sqlite
DB_NAME=mathkangaroo
DB_USER=mathkangaroo
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

DEFAULT_FROM_EMAIL="Math Kangaroo Bangladesh <no-reply@example.org>"
# Configure a real email provider in production:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
