# Production configuration for https://kangaroomathbd.org/ on cPanel.
#
# 1. Copy this file to the application root as .env:
#        cp deploy/cpanel/production.env.example .env && chmod 600 .env
# 2. Replace every value in <angle brackets>. CPANELUSER is your cPanel
#    username.
# 3. Restart the app (cPanel > Setup Python App > Restart) after any change.
#
# Keep comments on their own lines. Generate passwords from letters and
# digits only (24+ characters); then no quoting is ever needed. Otherwise wrap
# a value containing spaces or " #" in single quotes, and inside them write
# ' as \' and a backslash as \\.
# DEBUG is always off on the live site; passenger_wsgi.py enforces it.

# --- Core --------------------------------------------------------------------
DJANGO_DEBUG=false
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<paste-the-generated-secret>
# Host names only (no https://, no trailing slash). www redirects to the bare
# domain through the .htaccess block.
DJANGO_ALLOWED_HOSTS=kangaroomathbd.org,www.kangaroomathbd.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://kangaroomathbd.org,https://www.kangaroomathbd.org

# --- HTTPS ---------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=true
# Start with one hour. After the site has worked over HTTPS for a week,
# raise this to 31536000 (one year).
DJANGO_SECURE_HSTS_SECONDS=3600
# Leave these false unless every subdomain of kangaroomathbd.org serves HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# true only when Cloudflare (or another proxy) sits in front of the server.
DJANGO_SECURE_PROXY_SSL_HEADER=false

# --- Database (PostgreSQL 14 or newer) -------------------------------------------
# cPanel > PostgreSQL Databases. Copy the names exactly as cPanel lists them:
# the prefix is usually your username, but on some servers only its first
# 8 characters.
DB_ENGINE=postgresql
DB_NAME=<CPANELUSER>_mathkangaroo
DB_USER=<CPANELUSER>_mkweb
DB_PASSWORD=<database-password>
DB_HOST=localhost
DB_PORT=5432
# Only for an external (managed) PostgreSQL server instead of cPanel's own:
# DB_SSLMODE=require

# --- Files -----------------------------------------------------------------------
# Static and media live in the domain's document root so the web server serves
# them directly. Private media (question-paper PDFs) must stay OUTSIDE
# public_html. If kangaroomathbd.org's document root is not public_html,
# use the folder cPanel > Domains shows.
DJANGO_STATIC_ROOT=/home/<CPANELUSER>/public_html/static
DJANGO_MEDIA_ROOT=/home/<CPANELUSER>/public_html/media
DJANGO_PRIVATE_MEDIA_ROOT=/home/<CPANELUSER>/mathkangaroo-data/private_media
DJANGO_FILE_UPLOAD_TEMP_DIR=/home/<CPANELUSER>/mathkangaroo-data/upload_tmp

# --- Email ---------------------------------------------------------------------------
# Create the mailbox in cPanel > Email Accounts; Connect Devices lists these
# values. Port 465 uses SSL; for port 587 set EMAIL_USE_SSL=false and
# EMAIL_USE_TLS=true.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.kangaroomathbd.org
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=no-reply@kangaroomathbd.org
EMAIL_HOST_PASSWORD=<mailbox-password>
DEFAULT_FROM_EMAIL="Math Kangaroo Bangladesh <no-reply@kangaroomathbd.org>"
SERVER_EMAIL=no-reply@kangaroomathbd.org
# Optional: who receives an email when the site hits a server error.
# DJANGO_ADMINS="Your Name <you@kangaroomathbd.org>"

# --- Logging ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=/home/<CPANELUSER>/mathkangaroo-data/logs/django.log
