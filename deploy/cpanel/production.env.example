# Production configuration for cPanel.
#
# 1. Copy this file to the application root as .env:
#        cp deploy/cpanel/production.env.example .env && chmod 600 .env
# 2. Replace every value in <angle brackets>. CPANELUSER is your cPanel
#    username; example.org is the site's domain.
# 3. Restart the app (cPanel > Setup Python App > Restart) after any change.
#
# Keep comments on their own lines; values with spaces need double quotes.

# --- Core --------------------------------------------------------------------
DJANGO_DEBUG=false
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=<paste-the-generated-secret>
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org

# --- HTTPS ---------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=true
# Start with one hour. After the site has worked over HTTPS for a week,
# raise this to 31536000 (one year).
DJANGO_SECURE_HSTS_SECONDS=3600
# Leave these false unless every subdomain of the domain serves HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# true only when Cloudflare (or another proxy) sits in front of the server.
DJANGO_SECURE_PROXY_SSL_HEADER=false

# --- Database ------------------------------------------------------------------
# cPanel > PostgreSQL Databases. cPanel prefixes database and user names with
# CPANELUSER_. Use DB_ENGINE=mysql and DB_PORT=3306 only if the host has no
# PostgreSQL (cPanel > MySQL Databases).
DB_ENGINE=postgresql
DB_NAME=<CPANELUSER>_mathkangaroo
DB_USER=<CPANELUSER>_mkweb
DB_PASSWORD=<database-password>
DB_HOST=localhost
DB_PORT=5432

# --- Files -----------------------------------------------------------------------
# Static and media live in the domain's document root so the web server serves
# them directly. Private media (question-paper PDFs) must stay OUTSIDE
# public_html. Use the domain's real document root if it is not public_html
# (cPanel > Domains shows it).
DJANGO_STATIC_ROOT=/home/<CPANELUSER>/public_html/static
DJANGO_MEDIA_ROOT=/home/<CPANELUSER>/public_html/media
DJANGO_PRIVATE_MEDIA_ROOT=/home/<CPANELUSER>/mathkangaroo-data/private_media
DJANGO_FILE_UPLOAD_TEMP_DIR=/home/<CPANELUSER>/mathkangaroo-data/upload_tmp

# --- Email ---------------------------------------------------------------------------
# cPanel > Email Accounts > Connect Devices lists these values. Port 465 uses
# SSL; for port 587 set EMAIL_USE_SSL=false and EMAIL_USE_TLS=true.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.org
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=no-reply@example.org
EMAIL_HOST_PASSWORD=<mailbox-password>
DEFAULT_FROM_EMAIL="Math Kangaroo Bangladesh <no-reply@example.org>"
SERVER_EMAIL=no-reply@example.org
# Who receives an email when the site hits a server error (comma-separated).
DJANGO_ADMINS="Site Admin <admin@example.org>"

# --- Logging ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=/home/<CPANELUSER>/mathkangaroo-data/logs/django.log
