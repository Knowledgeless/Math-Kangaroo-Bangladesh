# Local development configuration. Copy to .env (git-ignored) if you need to
# change anything; with no .env the project runs in DEBUG mode with SQLite.
# For the cPanel production template see deploy/cpanel/production.env.example.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local development uses SQLite. Production uses DB_ENGINE=postgresql
# (or DB_ENGINE=mysql on hosts that offer only MySQL/MariaDB).
DB_ENGINE=sqlite
DB_NAME=mathkangaroo
DB_USER=mathkangaroo
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

DEFAULT_FROM_EMAIL="Math Kangaroo Bangladesh <no-reply@example.org>"
# Configure a real email provider in production:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional overrides (defaults shown):
# DJANGO_STATIC_ROOT=./staticfiles
# DJANGO_MEDIA_ROOT=./media
# DJANGO_PRIVATE_MEDIA_ROOT=./private_media
